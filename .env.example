# MySQL schema must already exist; Hibernate creates and updates its tables.
DB_URL=jdbc:mysql://localhost:3306/ptit_meeting?useSSL=false&serverTimezone=Asia/Ho_Chi_Minh&allowPublicKeyRetrieval=true&characterEncoding=UTF-8
DB_USERNAME=root
DB_PASSWORD=change-me
JPA_DDL_AUTO=update
LIQUIBASE_ENABLED=false

# Use a random secret with at least 32 bytes for HS256.
JWT_SECRET_KEY=replace-with-a-random-secret-at-least-32-bytes
JWT_ACCESS_EXPIRATION_MS=1800000
JWT_REFRESH_EXPIRATION_MS=604800000

# Redis is required by login rate limiting and refresh-token storage.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Redis + LiveKit are started by compose.yml; backend Java still runs on the host.
LIVEKIT_ENABLED=true
LIVEKIT_API_URL=http://localhost:7880
LIVEKIT_WS_URL=ws://localhost:7880
LIVEKIT_API_KEY=localdevkey
LIVEKIT_API_SECRET=replace-with-a-random-local-livekit-secret
LIVEKIT_JOIN_TOKEN_TTL_MS=600000
LIVEKIT_WEBHOOK_URL=http://host.docker.internal:8080/api/v1/integrations/livekit/webhook

# Optional Microsoft Entra ID login.
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
AZURE_AD_TENANT_ID=common
AZURE_AD_REDIRECT_URI=http://localhost:3000/auth/callback
